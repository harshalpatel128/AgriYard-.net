<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="AgriYard.Shared.Admin" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AgriYard Admin Portal</title>

    <%-- Admin & Core Stylesheets --%>
    <link rel="stylesheet" href="~/Content/site.css" />
    <link rel="stylesheet" href="~/Content/validation.css" />
    <link rel="stylesheet" href="~/Content/admin.css" />

    <asp:ContentPlaceHolder ID="AdminHeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="admin-page-wrapper">
    <form id="adminForm" runat="server">
        <%-- Top Header (AgriYard Admin left, Admin Panel right) --%>
        <header class="admin-header">
            <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="admin-brand-title">
                AgriYard Admin
            </a>
            <div class="admin-badge-label">
                Admin Panel
            </div>
        </header>

        <%-- Two Column Admin Shell --%>
        <div class="admin-shell">
            <%-- Left Sidebar Navigation --%>
            <aside class="admin-sidebar">
                <ul class="admin-nav-list">
                    <li class="admin-nav-item">
                        <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="admin-nav-btn <%= GetActiveAdminClass("dashboard") %>">
                            Dashboard
                        </a>
                    </li>
                    <li class="admin-nav-item">
                        <a href="<%= ResolveUrl("~/Admin/ManageData.aspx") %>" class="admin-nav-btn <%= GetActiveAdminClass("managedata") %>">
                            Manage Data
                        </a>
                    </li>
                    <li class="admin-nav-item">
                        <a href="<%= ResolveUrl("~/Admin/UsersAlerts.aspx") %>" class="admin-nav-btn <%= GetActiveAdminClass("usersalerts") %>">
                            Users & Alerts
                        </a>
                    </li>
                    <li class="admin-nav-item">
                        <a href="<%= ResolveUrl("~/Admin/Settings.aspx") %>" class="admin-nav-btn <%= GetActiveAdminClass("settings") %>">
                            Settings
                        </a>
                    </li>
                    <li class="admin-nav-item" style="margin-top: 16px;">
                        <a href="<%= ResolveUrl("~/Default.aspx") %>" class="admin-nav-btn" style="color: #687968;">
                            ← View Public Site
                        </a>
                    </li>
                </ul>
            </aside>

            <%-- Main Content Workspace --%>
            <main class="admin-main-content">
                <asp:ContentPlaceHolder ID="AdminMainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>

    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
